{
  "name": "brujula-salvaje",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "api:generate": "ng-openapi-gen -c ng-openapi-gen.json",
    "tokens:generate": "node generate-tokens.mjs",
    "e2e": "playwright test",
    "serve:ssr:brujula-salvaje": "node dist/brujula-salvaje/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/ssr": "22.2.0",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "ng-openapi-gen": "1.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  }
}
