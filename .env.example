# =============================================================================
# Brújula Salvaje — variables de entorno (TKT-F6-001, Skill_devops §6 / §23.1)
# PLANTILLA VERSIONADA SIN SECRETOS. Todos los valores son FICTICIOS y NO PRODUCTIVOS.
#
#   Crear el .env local (no versionado, .gitignore):  bash scripts/ops/init-env.sh
#   -> copia este archivo y sustituye cada CHANGE_ME por un valor aleatorio local.
#
# Secretos de entornos compartidos o productivos: NUNCA en archivos .env; se gestionan con el
# mecanismo de secretos de la plataforma, previa Puerta Humana (CLAUDE.md §0.5, DEC-AUTO-002).
# =============================================================================

# ---------- Compose ----------
# Nombre del proyecto (prefijo de contenedores, redes y volúmenes)
COMPOSE_PROJECT_NAME=brujula
# Puerto del proxy publicado SOLO en 127.0.0.1 (http://localhost:8080)
PROXY_HOST_PORT=8080
# Puerto de PostgreSQL publicado SOLO en 127.0.0.1 y SOLO con compose.debug.yaml
DB_DEBUG_HOST_PORT=55432
# Versión que se graba en las etiquetas OCI de las imágenes
APP_VERSION=0.0.0-dev

# ---------- PostgreSQL 18.6 (INFRA-DB-000, infra/db/init/10-bootstrap.sh) ----------
# Superusuario de bootstrap (usuario "postgres"): solo lo usa el init del contenedor db.
# Ningún servicio de la aplicación se conecta con él.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Nombre de la base de datos (DB_HANDOFF: brujula)
DB_NAME=brujula
# Rol DDL: solo el job "migrate" (manage.py migrate)
APP_MIGRATOR_PASSWORD=CHANGE_ME
# Rol de la aplicación (web y scheduler): DML sin DDL
APP_RW_PASSWORD=CHANGE_ME
# Rol de diagnóstico e informes (solo lectura, sin PII)
READONLY_PASSWORD=CHANGE_ME
# Rol de copias (pg_read_all_data), usado solo por el servicio backup
APP_BACKUP_PASSWORD=CHANGE_ME

# ---------- Django 5.2 (backend) ----------
# Clave secreta de Django (firma de sesiones y CSRF)
DJANGO_SECRET_KEY=CHANGE_ME
# Nunca true fuera de la depuración local puntual
DJANGO_DEBUG=false
# Hosts aceptados: navegador (localhost), healthcheck (127.0.0.1) y llamadas del SSR (backend)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Orígenes de confianza para CSRF (mismo origen a través del proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Cookies Secure (ADR-API-001). Los navegadores aceptan Secure en http://localhost.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# En local no hay TLS: sin redirección ni HSTS (HSTS solo en producción, DEC-004)
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
# Número de proxies de confianza delante de Django (nginx) para X-Forwarded-For (DEC-AUTO-111)
DJANGO_NUM_PROXIES=1
# Nivel de log (JSON, sin PII)
DJANGO_LOG_LEVEL=INFO
# Clave HMAC para las claves de throttling por IP truncada (ADR-DB-005 §3)
THROTTLE_HMAC_KEY=CHANGE_ME
# Clave Fernet (32 bytes base64 urlsafe) para cifrar secreto_mfa en la aplicación
MFA_FERNET_KEY=CHANGE_ME_FERNET
# Prefijo público de los derivados de medios DISPONIBLES (servidos por el proxy, DEC-AUTO-147)
MEDIA_PUBLIC_URL=/media/publico/
# Base de las URI "type" de los errores application/problem+json (RFC 9457, DEC-AUTO-103).
# Valor FICTICIO (dominio reservado .example): se sustituye por el dominio real en producción.
PROBLEM_TYPE_BASE_URL=https://brujulasalvaje.example
# gunicorn: workers síncronos y timeout (subida síncrona de medios, ADR-API-002 §8)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
# OpenTelemetry: desactivado en local (no hay recolector); en CI/prod se configura el endpoint OTLP
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Angular 22 SSR (frontend) ----------
# Hosts permitidos por el motor SSR (protección SSRF de @angular/ssr)
NG_ALLOWED_HOSTS=localhost,127.0.0.1
# URL interna de la API para las peticiones hechas DESDE el servidor SSR (red interna "app")
API_INTERNAL_URL=http://backend:8000

# ---------- Copias de seguridad (perfil ops, ADR-DB-004 §3) ----------
# Clave PÚBLICA age (age1...). La privada se guarda FUERA del repositorio.
# Generar una clave local desechable: ver DEVOPS_HANDOFF.md §5.4. Sin clave válida, la copia falla.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# Copias diarias rotativas que se conservan (DEC-AUTO-052)
BACKUP_RETENTION_DAYS=30
